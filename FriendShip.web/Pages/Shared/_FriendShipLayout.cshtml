@{
    var title = ViewData["Title"]?.ToString() ?? "چقدر منو می‌شناسی؟";
    var kind = ViewData["PageKind"]?.ToString() ?? "standard";
    var focused = kind is "play" or "create" or "join";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#10122f" />
    <meta name="color-scheme" content="dark" />
    <title>@title | فرندشیپ</title>
    <link rel="preload" href="@Url.Content("~/fonts/vazirmatn/Vazirmatn[wght].woff2")" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/friendship/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/friendship/game-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="fs-app page-@kind @(focused ? "is-focused" : "")">
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z" /></symbol>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z" /></symbol>
        <symbol id="i-game" viewBox="0 0 24 24"><path d="M7 7h10c3 0 5 11 3 12-2 1-4-4-5-4H9c-1 0-3 5-5 4-2-1 0-12 3-12Z M8 9v5m-2.5-2.5h5M16 10h.01M18 13h.01" /></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10m8 10V4m8 16v-6M2 21h20"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M20 12H4m6-6-6 6 6 6"/></symbol>
        <symbol id="i-back" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
        <symbol id="i-link" viewBox="0 0 24 24"><path d="m10 13 4-4m-5 7-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 0 2-2a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" transform="translate(1 1)"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-share" viewBox="0 0 24 24"><path d="M12 16V3m-5 5 5-5 5 5M5 13H3v8h18v-8h-2"/></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20 4c-3-2-6 0-8 2-2-2-5-4-8-2-7 5 8 17 8 17S27 9 20 4Z"/></symbol>
        <symbol id="i-bolt" viewBox="0 0 24 24"><path d="m14 2-9 12h6l-1 8 9-12h-6l1-8Z"/></symbol>
        <symbol id="i-crown" viewBox="0 0 24 24"><path d="m3 6 5 4 4-7 4 7 5-4-2 13H5L3 6ZM6 22h12"/></symbol>
    </svg>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <header class="site-header"><div class="container header-inner">
        <a class="brand" asp-page="/Ui/Index" aria-label="فرندشیپ، صفحه اصلی"><span class="brand-icon"><svg class="icon"><use href="#i-spark" /></svg></span><span><strong>فرندشیپ<span class="brand-dot">.</span></strong><small>رفاقت، با یه چاشنی بازی</small></span></a>
        <nav class="main-nav" aria-label="منوی اصلی">
        @if (focused)
        { <a class="nav-back" asp-page="/Ui/Game/Index">بازی من <svg class="icon"><use href="#i-back" /></svg></a> }
        else
        {
            <a asp-page="/Ui/Game/Index"><svg class="icon"><use href="#i-game" /></svg> بازی من</a>
            <a asp-page="/Ui/Discover/Index"><svg class="icon"><use href="#i-spark" /></svg> کشف من</a>
            @if (User.Identity?.IsAuthenticated == true)
            { <a asp-page="/Ui/Profile"><svg class="icon"><use href="#i-user" /></svg> پروفایل</a> }
            else
            { <a class="nav-account" asp-page="/Ui/Account">ورود / شروع</a> }
        }
        </nav>
    </div></header>
    <main id="main-content" class="container main-content">@RenderBody()</main>
    <footer class="site-footer"><div class="container footer-inner"><span><svg class="icon"><use href="#i-heart" /></svg> یه بهونه برای بیشتر شناختن همدیگه</span><a asp-page="/Privacy">حریم خصوصی</a></div></footer>
    @if (!focused)
    {
        <nav class="mobile-dock" aria-label="پیمایش موبایل">
            <a asp-page="/Ui/Index" aria-current="@(currentPage == "/Ui/Index" ? "page" : null)"><svg class="icon"><use href="#i-home" /></svg><span>خونه</span></a>
            <a asp-page="/Ui/Game/Index" aria-current="@(currentPage.StartsWith("/Ui/Game") ? "page" : null)"><svg class="icon"><use href="#i-game" /></svg><span>بازی من</span></a>
            <a asp-page="/Ui/Discover/Index" aria-current="@(currentPage.StartsWith("/Ui/Discover") ? "page" : null)"><svg class="icon"><use href="#i-spark" /></svg><span>کشف من</span></a>
            <a asp-page="/Ui/Profile" aria-current="@(currentPage == "/Ui/Profile" ? "page" : null)"><svg class="icon"><use href="#i-user" /></svg><span>پروفایل</span></a>
        </nav>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body></html>
